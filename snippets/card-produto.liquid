<article class="card">
  <a href="{{ produto.url }}">
    <img src="{{ produto.featured_image | img_url: "400x" }}" alt="{{ produto.title }}" loading="lazy">
    <h3>{{ produto.title }}</h3>
    <p>{{ produto.price | money }}</p>
  </a>
</article>
